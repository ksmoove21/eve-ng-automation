# Credentials remain local. The EVE-NG server address is configured in
# config/servers.yaml. Replace the example server profile with your own EVE-NG endpoint.
#
# Minimum for REST/API discovery, status, templates, plan/apply, and lifecycle.
EVE_USERNAME=admin
EVE_PASSWORD=

# Required only for features that SSH to the EVE-NG host, such as DHCP/NAT
# management and console workflows that traverse the host.
EVE_SSH_USERNAME=root
EVE_SSH_PASSWORD=

# Used only by the optional EVE host DHCP DNS-management workflow.
EVE_DHCP_DNS=8.8.8.8,1.1.1.1

# Device credentials are separate from EVE-NG credentials. Populate these when
# device initialization, backup, restore, or console automation requires them.
CISCO_USERNAME=admin
CISCO_PASSWORD=
CISCO_ENABLE_SECRET=
PALO_USERNAME=admin
PALO_PASSWORD=
